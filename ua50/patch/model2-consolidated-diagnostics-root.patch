diff --git a/include/xllama/gpu_cross_arm_witness.h b/include/xllama/gpu_cross_arm_witness.h
new file mode 100644
index 0000000000000000000000000000000000000000..2d4bcd34378ef6656324bb8f3afcb3d23170eb84
--- /dev/null
+++ b/include/xllama/gpu_cross_arm_witness.h
@@ -0,0 +1,197 @@
+#pragma once
+#include "ua50/cross_arm_observer.h"
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace xllama::gpu_proof {
+// Synchronous diagnostic copy at the common CPU pack barrier. The only retained
+// bytes are bounded CPU-reference rows; hybrid data is compared before return.
+class CrossArmWitness final : public ua50::CrossArmObserver {
+public:
+ struct Key {uint32_t position,role,expert,slot,input_row,occurrence;};
+ static constexpr uint32_t any_slot=4;
+ struct Record {
+  Key key{};int32_t token[2]{-1,-1};uint32_t observed_slot[2]{any_slot,any_slot};uint32_t input_calls[2]{},output_calls[2]{};
+  bool input_seen[2]{},output_seen[2]{};bool q8_equal=false,f32_equal=false,output_equal=false;
+  uint32_t f32_violations=0,output_violations=0,q8_byte_differences=0,zero_blocks[2]{},bad_bsums[2]{},nonfinite_scales[2]{};
+  uint32_t scale_diff_blocks=0,qs_diff_bytes=0,bsums_diff_bytes=0;
+  double f32_max_abs=0,output_max_abs=0;
+  uint64_t f32_hash[2]{},q8_hash[2]{},output_hash[2]{};
+  uint32_t k=0,n=0;std::array<float,2048> cpu_f32{},cpu_output{};
+  std::array<unsigned char,2336> cpu_q8{};
+  std::array<float,2048> hybrid_f32{},hybrid_output{};std::array<unsigned char,2336> hybrid_q8{};
+ };
+ static constexpr size_t max_records=16,max_q8_bytes=2336;
+private:
+ std::vector<Record> rows_;uint32_t phase_=0,position_=0,prompt_count_=UINT32_MAX;int32_t token_=-1;
+ bool unavailable_=false,raw_=false;const char*reason_=nullptr;uint64_t work_ns_=0,work_units_=0;
+ uint64_t max_work_,max_time_ns_;uint32_t abs_ppm_,rel_ppm_;
+ static uint64_t hash(const void*data,size_t n)noexcept{
+  const auto*p=static_cast<const unsigned char*>(data);uint64_t h=14695981039346656037ull;
+  for(size_t i=0;i<n;++i){h^=p[i];h*=1099511628211ull;}return h;
+ }
+ static bool same(const Key&a,const Key&b)noexcept{
+  return a.position==b.position&&a.role==b.role&&a.expert==b.expert&&a.slot==b.slot&&a.input_row==b.input_row&&a.occurrence==b.occurrence;
+ }
+ void fail(const char*why)noexcept{unavailable_=true;if(!reason_)reason_=why;}
+ void charge(std::chrono::steady_clock::time_point start,uint64_t units)noexcept{
+  auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();
+  if(ns<0||uint64_t(ns)>UINT64_MAX-work_ns_||units>UINT64_MAX-work_units_){fail("ACCOUNTING");return;}
+  work_ns_+=uint64_t(ns);work_units_+=units;
+  if(work_ns_>max_time_ns_||work_units_>max_work_)fail("BUDGET");
+ }
+ static void q8_check(const unsigned char*q,size_t k,uint32_t&zeros,uint32_t&bad,uint32_t&nonfinite)noexcept{
+  for(size_t b=0;b<k/256;++b){const auto*p=q+b*292;float d=0;std::memcpy(&d,p,4);
+   if(!std::isfinite(d))++nonfinite;
+   bool zero=true;
+   for(size_t i=0;i<256;++i)if(p[4+i])zero=false;
+   if(zero)++zeros;
+   for(size_t group=0;group<16;++group){int sum=0;for(size_t i=0;i<16;++i)sum+=int(int8_t(p[4+group*16+i]));
+    int16_t stored=0;std::memcpy(&stored,p+260+group*2,2);if(stored!=sum)++bad;}
+  }
+ }
+ static void compare(const float*cpu,const float*other,size_t n,uint32_t abs_ppm,uint32_t rel_ppm,
+                     bool&equal,uint32_t&violations,double&max_abs)noexcept{
+  equal=true;for(size_t i=0;i<n;++i){uint32_t a=0,b=0;std::memcpy(&a,cpu+i,4);std::memcpy(&b,other+i,4);
+   if(a!=b)equal=false;
+   const double delta=std::abs(double(cpu[i])-double(other[i]));
+   max_abs=std::max(max_abs,delta);
+   if(delta>(double(abs_ppm)+double(rel_ppm)*std::abs(double(cpu[i])))/1e6)++violations;
+  }
+ }
+public:
+ void configure(uint32_t prompt_count)noexcept{prompt_count_=prompt_count;}
+ CrossArmWitness(std::vector<Key>keys,uint32_t abs_ppm,uint32_t rel_ppm,uint64_t max_work,uint32_t max_time_ms,bool raw=false)
+  :raw_(raw),max_work_(max_work),max_time_ns_(uint64_t(max_time_ms)*1000000),abs_ppm_(abs_ppm),rel_ppm_(rel_ppm){
+  if(keys.empty()||keys.size()>max_records||(raw&&keys.size()>8)||max_time_ms<1000||max_time_ms>120000||max_work==0||max_work>120000000||abs_ppm>1000000||rel_ppm>1000000)throw std::invalid_argument("cross-arm bounds");
+  for(const auto&key:keys){
+   if(key.position>128||key.role>113||key.expert>63||key.slot>any_slot||key.input_row>128||key.occurrence>3)throw std::invalid_argument("cross-arm identity range");
+   for(const auto&row:rows_)if((same(key,row.key))||
+    (key.position==row.key.position&&key.role==row.key.role&&key.expert==row.key.expert&&
+     key.input_row==row.key.input_row&&key.occurrence==row.key.occurrence&&
+     (key.slot==any_slot||row.key.slot==any_slot)))throw std::invalid_argument("cross-arm overlapping selection");
+   rows_.emplace_back();rows_.back().key=key;
+  }
+ }
+ void frame(uint32_t phase,uint32_t position,int32_t token)noexcept override{
+  if((phase!=1&&phase!=2)||position>128||token<0){fail("FRAME_IDENTITY");return;}
+  phase_=phase;position_=position;token_=token;
+ }
+ void input(uint32_t role,uint32_t expert,uint32_t slot,uint32_t input_row,const float*f32,size_t k,
+            const unsigned char*q8,size_t bytes)noexcept override{
+  const auto start=std::chrono::steady_clock::now();if(unavailable_)return;
+  if(!phase_||!f32||!q8||!(k==1536||k==2048)||bytes!=k/256*292||bytes>max_q8_bytes){fail("INPUT_SHAPE");return;}
+  for(auto&r:rows_)if(r.key.position==position_&&r.key.role==role&&r.key.expert==expert&&(r.key.slot==any_slot||r.key.slot==slot)&&r.key.input_row==input_row){
+   const auto arm=phase_-1,call=r.input_calls[arm]++;if(call!=r.key.occurrence)continue;
+   if(r.input_seen[arm]||(r.k&&r.k!=k)){fail("INPUT_ORDER_SHAPE");return;}
+   for(size_t i=0;i<k;++i)if(!std::isfinite(f32[i])){fail("NONFINITE_F32");return;}
+   r.input_seen[arm]=true;r.token[arm]=token_;r.observed_slot[arm]=slot;r.k=uint32_t(k);
+   r.f32_hash[arm]=hash(f32,k*4);r.q8_hash[arm]=hash(q8,bytes);
+   q8_check(q8,k,r.zero_blocks[arm],r.bad_bsums[arm],r.nonfinite_scales[arm]);
+   if(arm==0){std::memcpy(r.cpu_f32.data(),f32,k*4);std::memcpy(r.cpu_q8.data(),q8,bytes);}
+   else if(r.input_seen[0]&&r.token[0]==token_){
+    if(raw_){std::memcpy(r.hybrid_f32.data(),f32,k*4);std::memcpy(r.hybrid_q8.data(),q8,bytes);}
+    compare(r.cpu_f32.data(),f32,k,abs_ppm_,rel_ppm_,r.f32_equal,r.f32_violations,r.f32_max_abs);
+    r.q8_equal=std::memcmp(r.cpu_q8.data(),q8,bytes)==0;
+    for(size_t i=0;i<bytes;++i)if(r.cpu_q8[i]!=q8[i])++r.q8_byte_differences;
+    for(size_t b=0;b<k/256;++b){const auto*old=r.cpu_q8.data()+b*292;const auto*now=q8+b*292;
+     if(std::memcmp(old,now,4))++r.scale_diff_blocks;
+     for(size_t i=4;i<260;++i)if(old[i]!=now[i])++r.qs_diff_bytes;
+     for(size_t i=260;i<292;++i)if(old[i]!=now[i])++r.bsums_diff_bytes;
+    }
+   }
+   charge(start,2*k+bytes);return;
+  }
+ }
+ void output(uint32_t role,uint32_t expert,uint32_t slot,uint32_t input_row,const float*values,size_t n)noexcept override{
+  const auto start=std::chrono::steady_clock::now();if(unavailable_)return;
+  if(!phase_||!values||n<1||n>2048){fail("OUTPUT_SHAPE");return;}
+  for(auto&r:rows_)if(r.key.position==position_&&r.key.role==role&&r.key.expert==expert&&(r.key.slot==any_slot||r.key.slot==slot)&&r.key.input_row==input_row){
+   const auto arm=phase_-1,call=r.output_calls[arm]++;if(call!=r.key.occurrence)continue;
+   if(!r.input_seen[arm]||r.output_seen[arm]||r.observed_slot[arm]!=slot||(r.n&&r.n!=n)){fail("OUTPUT_ORDER_SHAPE");return;}
+   for(size_t i=0;i<n;++i)if(!std::isfinite(values[i])){fail("NONFINITE_OUTPUT");return;}
+   r.output_seen[arm]=true;r.n=uint32_t(n);r.output_hash[arm]=hash(values,n*4);
+   if(arm==0)std::memcpy(r.cpu_output.data(),values,n*4);
+   else if(r.output_seen[0]&&r.token[0]==token_){
+    if(raw_)std::memcpy(r.hybrid_output.data(),values,n*4);
+    compare(r.cpu_output.data(),values,n,abs_ppm_,rel_ppm_,r.output_equal,r.output_violations,r.output_max_abs);
+   }
+   charge(start,n);return;
+  }
+ }
+ void unavailable(const char*reason)noexcept override{fail(reason?reason:"DIAGNOSTIC_UNAVAILABLE");}
+ bool available()const noexcept{return !unavailable_;}
+ const char*reason()const noexcept{return reason_;}
+ uint64_t work_ns()const noexcept{return work_ns_;}
+ uint64_t work_units()const noexcept{return work_units_;}
+ const std::vector<Record>&records()const noexcept{return rows_;}
+ std::string summary(uint64_t max_output_bytes)const{
+  if(max_output_bytes<4096||max_output_bytes>(2ull<<20))throw std::invalid_argument("cross-arm output cap");
+  std::string s="{\"schema\":\"ua68-model2-cross-arm-v1\",\"unavailable\":"+
+   std::string(unavailable_?"true":"false")+",\"reason\":"+
+   (reason_?std::string("\"")+reason_+"\"":"null")+
+   ",\"selected\":"+std::to_string(rows_.size())+",\"diagnostic_work_ns\":"+std::to_string(work_ns_)+
+   ",\"diagnostic_work_units\":"+std::to_string(work_units_)+",\"raw_private\":"+
+   (raw_?"true":"false")+",\"rows\":[";
+  s.reserve(size_t(max_output_bytes));
+  auto hex=[&](const void*data,size_t n){static constexpr char digits[]="0123456789abcdef";
+   const auto*b=static_cast<const unsigned char*>(data);
+   if(n>(max_output_bytes-s.size())/2)throw std::length_error("cross-arm raw cap");
+   for(size_t k=0;k<n;++k){s+=digits[b[k]>>4];s+=digits[b[k]&15];}
+  };
+  auto real=[&](double d){char b[64];auto x=std::to_chars(b,b+sizeof(b),d,std::chars_format::general,17);
+   if(x.ec!=std::errc{})throw std::runtime_error("cross-arm numeric serialization");
+   s.append(b,x.ptr);};
+  for(size_t i=0;i<rows_.size();++i){const auto&r=rows_[i];if(i)s+=',';
+   const bool input_pair=r.input_seen[0]&&r.input_seen[1]&&r.token[0]==r.token[1];
+   const bool output_pair=input_pair&&r.output_seen[0]&&r.output_seen[1];
+   const char*gap=r.key.position>prompt_count_?"POSITION_OUTSIDE_WORKLOAD":
+    !r.input_seen[0]?"CPU_INPUT_NOT_OBSERVED":!r.input_seen[1]?"HYBRID_INPUT_NOT_OBSERVED":
+    !input_pair?"TOKEN_UNPAIRED":!r.output_seen[0]?"CPU_OUTPUT_NOT_OBSERVED":
+    !r.output_seen[1]?"HYBRID_OUTPUT_NOT_OBSERVED":"";
+   s+="{\"position\":"+std::to_string(r.key.position)+",\"role\":"+std::to_string(r.key.role)+
+     ",\"expert\":"+std::to_string(r.key.expert)+",\"slot\":"+(r.key.slot==any_slot?"null":std::to_string(r.key.slot))+
+     ",\"CPU_slot\":"+(r.input_seen[0]?std::to_string(r.observed_slot[0]):"null")+
+     ",\"hybrid_slot\":"+(r.input_seen[1]?std::to_string(r.observed_slot[1]):"null")+
+     ",\"input_row\":"+std::to_string(r.key.input_row)+",\"occurrence\":"+std::to_string(r.key.occurrence)+
+     ",\"CPU_token\":"+std::to_string(r.token[0])+",\"hybrid_token\":"+std::to_string(r.token[1])+
+     ",\"CPU_input_seen\":"+(r.input_seen[0]?"true":"false")+",\"hybrid_input_seen\":"+(r.input_seen[1]?"true":"false")+
+     ",\"CPU_output_seen\":"+(r.output_seen[0]?"true":"false")+",\"hybrid_output_seen\":"+(r.output_seen[1]?"true":"false")+
+     ",\"gap\":\""+gap+"\",\"F32_equal_bits\":"+(input_pair?(r.f32_equal?"true":"false"):"null")+
+     ",\"output_equal_bits\":"+(output_pair?(r.output_equal?"true":"false"):"null")+
+     ",\"F32_compared\":"+std::to_string(input_pair?r.k:0)+",\"output_compared\":"+std::to_string(output_pair?r.n:0)+
+     ",\"k\":"+std::to_string(r.k)+",\"n\":"+std::to_string(r.n)+
+     ",\"CPU_F32_fnv1a64\":"+std::to_string(r.f32_hash[0])+",\"hybrid_F32_fnv1a64\":"+std::to_string(r.f32_hash[1])+
+     ",\"CPU_Q8_fnv1a64\":"+std::to_string(r.q8_hash[0])+",\"hybrid_Q8_fnv1a64\":"+std::to_string(r.q8_hash[1])+
+     ",\"CPU_output_fnv1a64\":"+std::to_string(r.output_hash[0])+",\"hybrid_output_fnv1a64\":"+std::to_string(r.output_hash[1])+
+     ",\"F32_violations\":"+std::to_string(r.f32_violations)+",\"output_violations\":"+std::to_string(r.output_violations)+
+     ",\"Q8_byte_differences\":"+std::to_string(r.q8_byte_differences)+
+     ",\"Q8_scale_diff_blocks\":"+std::to_string(r.scale_diff_blocks)+",\"Q8_qs_diff_bytes\":"+std::to_string(r.qs_diff_bytes)+
+     ",\"Q8_bsums_diff_bytes\":"+std::to_string(r.bsums_diff_bytes)+
+     ",\"CPU_Q8_zero_blocks\":"+std::to_string(r.zero_blocks[0])+",\"hybrid_Q8_zero_blocks\":"+std::to_string(r.zero_blocks[1])+
+     ",\"CPU_Q8_bsums_anomalies\":"+std::to_string(r.bad_bsums[0])+",\"hybrid_Q8_bsums_anomalies\":"+std::to_string(r.bad_bsums[1])+
+     ",\"CPU_Q8_nonfinite_scales\":"+std::to_string(r.nonfinite_scales[0])+",\"hybrid_Q8_nonfinite_scales\":"+std::to_string(r.nonfinite_scales[1])+
+     ",\"F32_max_abs\":";real(r.f32_max_abs);s+=",\"output_max_abs\":";real(r.output_max_abs);
+   if(raw_&&r.input_seen[0]&&r.input_seen[1]&&r.output_seen[0]&&r.output_seen[1]&&r.token[0]==r.token[1]){
+    const size_t qbytes=size_t(r.k)/256*292;
+    s+=",\"CPU_F32_hex\":\"";hex(r.cpu_f32.data(),size_t(r.k)*4);s+='"';
+    s+=",\"hybrid_F32_hex\":\"";hex(r.hybrid_f32.data(),size_t(r.k)*4);s+='"';
+    s+=",\"CPU_Q8_hex\":\"";hex(r.cpu_q8.data(),qbytes);s+='"';
+    s+=",\"hybrid_Q8_hex\":\"";hex(r.hybrid_q8.data(),qbytes);s+='"';
+    s+=",\"CPU_output_hex\":\"";hex(r.cpu_output.data(),size_t(r.n)*4);s+='"';
+    s+=",\"hybrid_output_hex\":\"";hex(r.hybrid_output.data(),size_t(r.n)*4);s+='"';
+   }
+   s+='}';if(s.size()>max_output_bytes)throw std::length_error("cross-arm output cap");
+  }
+  s+="]}";if(s.size()>max_output_bytes)throw std::length_error("cross-arm output cap");return s;
+ }
+};
+}
diff --git a/include/xllama/gpu_diagnostic_plan_v3.h b/include/xllama/gpu_diagnostic_plan_v3.h
new file mode 100644
index 0000000000000000000000000000000000000000..68255ae98316df0a06ab2e77c0b2d3008a2ef5ab
--- /dev/null
+++ b/include/xllama/gpu_diagnostic_plan_v3.h
@@ -0,0 +1,124 @@
+#pragma once
+#include "gpu_diagnostic_plan.h"
+#include "gpu_graph_witness.h"
+#include "gpu_cross_arm_witness.h"
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace xllama::gpu_diagnostic {
+// Versioned diagnostic selection. V3 is observational; the fixed proof
+// contract and immutable execution envelope remain in gpu_run_config.h.
+struct PlanV3 {
+ Plan base;
+ std::vector<gpu_proof::GraphWitness::Selection> graph;
+ std::vector<gpu_proof::CrossArmWitness::Key> cross_arm;
+ bool graph_workload_axis=false,raw_private=false;
+ uint32_t graph_abs_ppm=1000,graph_rel_ppm=1000,cross_abs_ppm=1000,cross_rel_ppm=1000;
+ uint64_t graph_memory=0,graph_output=0,graph_work=0,cross_memory=0,cross_output=0,cross_work=0;
+ uint32_t graph_time_ms=0,cross_time_ms=0;
+ uint64_t graph_memory_upper=0,graph_output_upper=0,graph_work_upper=0,cross_output_upper=0;
+ uint64_t serializer_charge=0;
+ size_t owned_bytes()const noexcept{
+  size_t n=sizeof(*this)+graph.capacity()*sizeof(gpu_proof::GraphWitness::Selection)+
+   cross_arm.capacity()*sizeof(gpu_proof::CrossArmWitness::Key);
+  for(const auto&entry:graph)n+=entry.point.capacity();
+  return n;
+ }
+};
+inline PlanV3 parse_v3(const dev_run::Json&j){
+ using J=dev_run::Json;
+ j.keys({"schema","overview","vectors","sampling","analysis","output","budgets","graph","cross_arm"});
+ j.at("schema").eq("ua68-model2-diagnostics-v2");
+ J old;old.type=J::Type::object;
+ J version;version.type=J::Type::string;version.text="ua68-model2-diagnostics-v1";
+ old.object.emplace_back("schema",std::move(version));
+ for(const char*name:{"overview","vectors","sampling","analysis","output","budgets"})old.object.emplace_back(name,j.at(name));
+ PlanV3 p;p.base=gpu_diagnostic::parse(old);
+ const auto&graph=j.at("graph");
+ if(graph.type!=J::Type::null){
+  graph.keys({"positions","layers","points","analysis","budgets"});
+  const auto pos=axis(graph.at("positions"),Plan::max_positions,true);
+  const auto layers=axis(graph.at("layers"),Plan::max_layers);
+  p.graph_workload_axis=pos.mode==Axis::Mode::all||pos.mode==Axis::Mode::workload;
+  const auto&points=graph.at("points");
+  dev_run::need(points.type==J::Type::array&&!points.array.empty()&&points.array.size()<=std::size(gpu_proof::GraphWitness::catalog),"graph point list bound");
+  std::vector<const gpu_proof::GraphWitness::Point*> chosen;
+  for(const auto&entry:points.array){
+   dev_run::need(entry.type==J::Type::string,"graph point type");
+   const gpu_proof::GraphWitness::Point*found=nullptr;
+   for(const auto&catalog:gpu_proof::GraphWitness::catalog)if(entry.text==catalog.key){found=&catalog;break;}
+   dev_run::need(found!=nullptr,"unsupported graph point");
+   for(const auto*prior:chosen)dev_run::need(prior!=found,"duplicate graph point");
+   chosen.push_back(found);
+  }
+  const auto&analysis=graph.at("analysis");analysis.keys({"absolute_ppm","relative_ppm"});
+  p.graph_abs_ppm=uint32_t(analysis.at("absolute_ppm").range(0,1000000));
+  p.graph_rel_ppm=uint32_t(analysis.at("relative_ppm").range(0,1000000));
+  const auto&b=graph.at("budgets");b.keys({"max_output_bytes","max_extra_memory_bytes","max_reference_work","max_time_ms"});
+  p.graph_output=b.at("max_output_bytes").range(4096,Plan::output_ceiling);
+  p.graph_memory=b.at("max_extra_memory_bytes").range(1u<<20,Plan::memory_ceiling);
+  p.graph_work=b.at("max_reference_work").range(1,Plan::work_ceiling);
+  p.graph_time_ms=uint32_t(b.at("max_time_ms").range(1000,Plan::time_ceiling_ms));
+  p.graph_memory_upper=1048576;
+  p.graph_output_upper=4096;
+  for(uint32_t position=0;position<Plan::max_positions;++position)if(pos.contains(position,Plan::max_positions))
+   for(uint32_t layer=0;layer<Plan::max_layers;++layer)if(layers.contains(layer,Plan::max_layers))
+    for(const auto*point:chosen){
+     if(!point->layer&&layer!=0)continue;
+     p.graph.push_back({position,layer,point->key});
+     p.graph_memory_upper+=sizeof(gpu_proof::GraphWitness::Row)+sizeof(size_t)+uint64_t(point->max_elements)*8;
+     p.graph_output_upper+=gpu_proof::GraphWitness::max_encoded_row_bytes;
+     p.graph_work_upper+=uint64_t(point->max_elements)*2;
+    }
+  dev_run::need(!p.graph.empty()&&p.graph.size()<=8192&&p.graph_memory_upper<=p.graph_memory&&
+   p.graph_output_upper<=p.graph_output&&p.graph_work_upper<=p.graph_work,"graph expanded bounds");
+ }
+ const auto&cross=j.at("cross_arm");
+ if(cross.type!=J::Type::null){
+  cross.keys({"rows","analysis","raw_private","budgets"});
+  const auto&rows=cross.at("rows");dev_run::need(rows.type==J::Type::array&&!rows.array.empty()&&rows.array.size()<=16,"cross-arm rows bound");
+  for(const auto&entry:rows.array){
+   entry.keys({"position","role","expert","slot","input_row","occurrence"});
+   gpu_proof::CrossArmWitness::Key key{
+    uint32_t(entry.at("position").range(0,128)),uint32_t(entry.at("role").range(0,113)),
+    uint32_t(entry.at("expert").range(0,63)),
+    entry.at("slot").type==J::Type::null?gpu_proof::CrossArmWitness::any_slot:uint32_t(entry.at("slot").range(0,3)),
+    uint32_t(entry.at("input_row").range(0,128)),uint32_t(entry.at("occurrence").range(0,3))};
+   for(const auto&prior:p.cross_arm)dev_run::need(
+    prior.position!=key.position||prior.role!=key.role||prior.expert!=key.expert||
+    (prior.slot!=key.slot&&prior.slot!=gpu_proof::CrossArmWitness::any_slot&&key.slot!=gpu_proof::CrossArmWitness::any_slot)||
+    prior.input_row!=key.input_row||prior.occurrence!=key.occurrence,
+    "duplicate cross-arm semantic key");
+   p.cross_arm.push_back(key);
+  }
+  dev_run::need(cross.at("raw_private").type==J::Type::boolean,"raw private type");
+  p.raw_private=cross.at("raw_private").flag;
+  dev_run::need(!p.raw_private||p.cross_arm.size()<=8,"raw private mapping cap");
+  const auto&a=cross.at("analysis");a.keys({"absolute_ppm","relative_ppm"});
+  p.cross_abs_ppm=uint32_t(a.at("absolute_ppm").range(0,1000000));
+  p.cross_rel_ppm=uint32_t(a.at("relative_ppm").range(0,1000000));
+  const auto&b=cross.at("budgets");b.keys({"max_output_bytes","max_extra_memory_bytes","max_reference_work","max_time_ms"});
+  p.cross_output=b.at("max_output_bytes").range(4096,Plan::output_ceiling);
+  p.cross_memory=b.at("max_extra_memory_bytes").range(1u<<20,Plan::memory_ceiling);
+  p.cross_work=b.at("max_reference_work").range(1,Plan::work_ceiling);
+  p.cross_time_ms=uint32_t(b.at("max_time_ms").range(1000,Plan::time_ceiling_ms));
+  const uint64_t logical_raw=uint64_t(p.cross_arm.size())*2*(2048*4+2336+2048*4);
+  dev_run::need(!p.raw_private||logical_raw<=512u*1024,"raw private logical cap");
+  p.cross_output_upper=4096+uint64_t(p.cross_arm.size())*1024+(p.raw_private?2*logical_raw:0);
+  dev_run::need(p.cross_output_upper<=p.cross_output,"cross-arm encoded output bound");
+  dev_run::need(sizeof(gpu_proof::CrossArmWitness)+uint64_t(p.cross_arm.size())*sizeof(gpu_proof::CrossArmWitness::Record)+1048576<=p.cross_memory,"cross-arm memory bound");
+  dev_run::need(uint64_t(p.cross_arm.size())*2*(2*2048+2336+2048)<=p.cross_work,"cross-arm work bound");
+ }
+ const uint64_t output_charge=p.base.output_budget+p.graph_output+p.cross_output;
+ p.serializer_charge=8*output_charge+(1u<<20);
+ // Summary strings, concatenation temporaries, sidecar and capacity coexist.
+ // Charge eight full output envelopes plus fixed serializer scratch.
+ dev_run::need(p.base.memory_budget+p.graph_memory+p.cross_memory+
+  p.serializer_charge<=Plan::memory_ceiling,"joint diagnostic memory ceiling");
+ dev_run::need(output_charge<=Plan::output_ceiling,"joint diagnostic output ceiling");
+ dev_run::need(p.base.reference_work_budget+p.graph_work+p.cross_work<=Plan::work_ceiling,"joint diagnostic work ceiling");
+ dev_run::need(uint64_t(p.base.time_budget_ms)+p.graph_time_ms+p.cross_time_ms<=Plan::time_ceiling_ms,"joint diagnostic time ceiling");
+ return p;
+}
+}
diff --git a/include/xllama/gpu_graph_witness.h b/include/xllama/gpu_graph_witness.h
new file mode 100644
index 0000000000000000000000000000000000000000..d08ef29f48a8210907795aed87fdfacff112b544
--- /dev/null
+++ b/include/xllama/gpu_graph_witness.h
@@ -0,0 +1,306 @@
+#pragma once
+#include "gpu_layer_witness.h"
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace xllama::gpu_proof {
+// Optional, selected graph boundaries. A construction callback is only a
+// candidate: absence, aliasing and unsupported shape remain explicit gaps.
+class GraphWitness final {
+public:
+ // Maximum encoded row, including two shapes and optional router arrays.
+ static constexpr uint64_t max_encoded_row_bytes=1600;
+ enum class Kind {f32,i32};
+ struct Point {const char *key;const char *final_name;Kind kind;uint32_t max_elements;bool layer;};
+ static constexpr Point catalog[]={
+  {"embedding","model.embed_tokens",Kind::f32,2048,false},
+  {"operator_norm","model.layers.{}.operator_norm",Kind::f32,2048,true},
+  {"operator_conv_out","model.layers.{}.conv.out_proj",Kind::f32,2048,true},
+  {"operator_attn_out","model.layers.{}.self_attn.out_proj",Kind::f32,2048,true},
+  {"pre_ffn_residual","model.layers.{}.pre_ffn_residual",Kind::f32,2048,true},
+  {"ffn_norm","model.layers.{}.ffn_norm",Kind::f32,2048,true},
+  {"router_logits","ffn_moe_logits",Kind::f32,64,true},
+  {"router_logits_biased","ffn_moe_logits_biased",Kind::f32,64,true},
+  {"router_probs","ffn_moe_probs",Kind::f32,64,true},
+  {"router_probs_biased","ffn_moe_probs_biased",Kind::f32,64,true},
+  {"router_probs_masked","ffn_moe_probs_masked",Kind::f32,64,true},
+  {"router_rank","ffn_moe_argsort",Kind::i32,64,true},
+  {"router_topk","ffn_moe_topk",Kind::i32,4,true},
+  {"router_weights","ffn_moe_weights",Kind::f32,4,true},
+  {"router_weights_norm","ffn_moe_weights_norm",Kind::f32,4,true},
+  {"router_weights_scaled","ffn_moe_weights_scaled",Kind::f32,4,true},
+  {"moe_gate","ffn_moe_gate",Kind::f32,6144,true},
+  {"moe_up","ffn_moe_up",Kind::f32,6144,true},
+  {"moe_activation","ffn_moe_swiglu",Kind::f32,6144,true},
+  {"moe_down","ffn_moe_down",Kind::f32,8192,true},
+  {"moe_weighted","ffn_moe_weighted",Kind::f32,8192,true},
+  {"moe_aggregate","ffn_moe_out",Kind::f32,2048,true},
+  {"dense_ffn_out","model.layers.{}.dense_ffn_out",Kind::f32,2048,true},
+  {"post_ffn_residual","model.layers.{}.post_ffn_residual",Kind::f32,2048,true},
+  {"result_norm","result_norm",Kind::f32,2048,false},
+  {"result_output","result_output",Kind::f32,128000,false},
+ };
+ struct Selection {uint32_t position=0,layer=0;std::string point;};
+ struct Row {
+  Selection selected;bool seen[2]{};int32_t token[2]{-1,-1};
+  uint32_t elements=0,violations=0,first_difference=UINT32_MAX,first_violation=UINT32_MAX;
+  double max_abs=0;uint64_t hash[2]{};std::string gap="NOT_OBSERVED";
+  LayerWitness::Shape shape[2]{};
+  bool score_stats_seen[2]{};double kth_margin[2]{};uint32_t exact_score_ties[2]{};
+  bool topk_seen[2]{},weights_seen[2]{};std::array<int32_t,4> topk[2]{};std::array<float,4> weights[2]{};
+  std::vector<unsigned char> reference;
+ };
+private:
+ std::vector<Row> rows_;std::array<std::vector<size_t>,129> by_position_{};
+ uint32_t phase_=0,position_=0,selected_upper_=0;int32_t token_=-1;
+ bool workload_axis_=false,configured_=false;
+ uint64_t memory_budget_,work_budget_,work_units_=0,time_ns_=0,time_cap_ns_,output_budget_;
+ uint64_t ask_calls_=0,sync_requests_=0,observe_calls_=0;
+ uint32_t abs_ppm_,rel_ppm_;bool unavailable_=false;const char*reason_=nullptr;
+ static const Point*point(std::string_view name)noexcept{
+  for(const auto&p:catalog)if(name==p.key)return &p;
+  return nullptr;
+ }
+ static std::string final_name(const Point&p,uint32_t layer){
+  std::string n=p.final_name;if(p.layer){n+='-';n+=std::to_string(layer);}return n;
+ }
+ static bool matches(const Point&p,uint32_t layer,std::string_view name)noexcept{
+  const std::string_view base(p.final_name);
+  if(!p.layer)return name==base;
+  if(name.size()<=base.size()+1||name.substr(0,base.size())!=base||name[base.size()]!='-')return false;
+  uint32_t parsed=0;
+  for(size_t i=base.size()+1;i<name.size();++i){
+   if(name[i]<'0'||name[i]>'9')return false;
+   parsed=parsed*10+uint32_t(name[i]-'0');if(parsed>=40)return false;
+  }
+  return parsed==layer;
+ }
+ // Exact model2 one-token endpoint shapes and pinned ggml op IDs. A changed
+ // producer or alias is a visible gap, never a numerically paired row.
+ static bool admitted_endpoint(std::string_view key,const LayerWitness::Shape&s)noexcept{
+  uint64_t n0=2048,n1=1;uint32_t op=0;
+  if(key=="embedding")op=40;
+  else if(key=="operator_norm"||key=="ffn_norm"||key=="result_norm")op=7;
+  else if(key=="operator_conv_out"||key=="operator_attn_out"||key=="dense_ffn_out"||key=="result_output")op=29;
+  else if(key=="pre_ffn_residual"||key=="post_ffn_residual")op=2;
+  else if(key=="router_logits"){n0=64;op=29;}
+  else if(key=="router_logits_biased"){n0=64;op=2;}
+  else if(key=="router_probs"){n0=64;op=46;}
+  else if(key=="router_probs_biased"){n0=64;op=2;}
+  else if(key=="router_probs_masked"){n0=64;op=36;}
+  else if(key=="router_rank"){n0=64;op=69;}
+  else if(key=="router_topk"){n0=4;op=37;}
+  else if(key=="router_weights"){n0=1;n1=4;op=40;}
+  else if(key=="router_weights_norm"){n0=4;op=8;}
+  else if(key=="router_weights_scaled"){n0=1;n1=4;op=32;}
+  else if(key=="moe_gate"||key=="moe_up"||key=="moe_activation"){n0=1536;n1=4;op=key=="moe_activation"?100:30;}
+  else if(key=="moe_down"){n0=2048;n1=4;op=30;}
+  else if(key=="moe_weighted"){n0=2048;n1=4;op=7;}
+  else if(key=="moe_aggregate")op=2;
+  else return false;
+  if(key=="result_output")n0=128000;
+  return s.op==op&&s.ne[0]==n0&&s.ne[1]==n1&&s.ne[2]==1&&s.ne[3]==1;
+ }
+ static uint64_t fnv(const void*p,size_t n)noexcept{
+  uint64_t h=14695981039346656037ull;const auto*b=static_cast<const unsigned char*>(p);
+  for(size_t i=0;i<n;++i){h^=b[i];h*=1099511628211ull;}return h;
+ }
+ void fail(const char*why)noexcept{unavailable_=true;if(!reason_)reason_=why;}
+public:
+ GraphWitness(std::vector<Selection> selected,uint32_t abs_ppm,uint32_t rel_ppm,
+              uint64_t memory_budget,uint64_t work_budget,uint32_t time_budget_ms,uint64_t output_budget=2ull<<20,bool workload_axis=false)
+  :workload_axis_(workload_axis),memory_budget_(memory_budget),work_budget_(work_budget),time_cap_ns_(uint64_t(time_budget_ms)*1000000),output_budget_(output_budget),abs_ppm_(abs_ppm),rel_ppm_(rel_ppm){
+  if(selected.empty()||selected.size()>8192||memory_budget>64ull*1024*1024||memory_budget<1024*1024||
+     work_budget==0||work_budget>120000000||time_budget_ms<1000||time_budget_ms>120000||
+     abs_ppm>1000000||rel_ppm>1000000||output_budget<4096||output_budget>(2ull<<20))throw std::invalid_argument("graph witness budget");
+  uint64_t charge=sizeof(*this)+selected.size()*sizeof(Row)+1024*1024;
+  for(auto&s:selected){
+   const auto*p=point(s.point);if(!p||s.position>128||(p->layer?s.layer>=40:s.layer!=0))throw std::invalid_argument("graph point unsupported");
+   for(const auto&r:rows_)if(r.selected.position==s.position&&r.selected.layer==s.layer&&r.selected.point==s.point)throw std::invalid_argument("graph point duplicate");
+   charge+=uint64_t(p->max_elements)*8; // retained CPU row plus transient read buffer
+   Row r;r.selected=std::move(s);by_position_[r.selected.position].push_back(rows_.size());rows_.push_back(std::move(r));
+  }
+  if(charge>memory_budget_)throw std::invalid_argument("graph witness memory");
+  selected_upper_=uint32_t(rows_.size());
+ }
+ void configure(uint32_t prompt_count)noexcept{
+  if(configured_||prompt_count<1||prompt_count>128){fail("GRAPH_PROMPT_ENVELOPE");return;}
+  configured_=true;
+  if(workload_axis_){
+   try{
+    rows_.erase(std::remove_if(rows_.begin(),rows_.end(),[prompt_count](const Row&r){return r.selected.position>prompt_count;}),rows_.end());
+    for(auto&entries:by_position_)entries.clear();
+    for(size_t i=0;i<rows_.size();++i)by_position_[rows_[i].selected.position].push_back(i);
+   }catch(...){fail("GRAPH_ALLOCATION_UNAVAILABLE");}
+  }else{
+   for(auto&r:rows_)if(r.selected.position>prompt_count){r.gap="POSITION_OUTSIDE_WORKLOAD";fail("POSITION_OUTSIDE_WORKLOAD");}
+  }
+ }
+ void begin(uint32_t phase,uint32_t position,int32_t token)noexcept{
+  if(!configured_||(phase!=1&&phase!=2)||position>128||token<0){fail("FRAME_IDENTITY");return;}
+  phase_=phase;position_=position;token_=token;
+ }
+ bool selected(std::string_view name)const noexcept{
+  if(unavailable_||!phase_)return false;
+  for(size_t index:by_position_[position_]){const auto&r=rows_[index];const auto*p=point(r.selected.point);
+   if(p&&matches(*p,r.selected.layer,name))return true;}
+  return false;
+ }
+ bool ask(std::string_view name)noexcept{
+  if(unavailable_||!phase_)return false;
+  const auto start=std::chrono::steady_clock::now();++ask_calls_;
+  const bool chosen=selected(name);
+  const auto elapsed=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();
+  if(elapsed<0||uint64_t(elapsed)>UINT64_MAX-time_ns_){fail("GRAPH_TIME_ACCOUNTING");return false;}
+  time_ns_+=uint64_t(elapsed);if(time_ns_>time_cap_ns_){fail("GRAPH_TIME_BUDGET");return false;}
+  if(chosen)++sync_requests_;
+  return chosen;
+ }
+ template<class Reader>void observe(std::string_view name,const LayerWitness::Shape&shape,Reader&&read)noexcept{
+  if(unavailable_||!phase_)return;
+  ++observe_calls_;
+  const auto start=std::chrono::steady_clock::now();
+  try{
+   for(size_t index:by_position_[position_]){auto&r=rows_[index];
+    const auto*p=point(r.selected.point);if(!p||!matches(*p,r.selected.layer,name))continue;
+    const auto arm=phase_-1;
+    if(r.seen[arm]){r.gap="DUPLICATE_OBSERVATION";return;}
+    if(!shape.contiguous||!shape.buffer||!shape.data||shape.bytes==0||shape.bytes%4||
+       shape.bytes>uint64_t(p->max_elements)*4||shape.ne[3]!=1||shape.nb[0]!=4||
+       (p->kind==Kind::f32?!shape.f32:!shape.i32)||!admitted_endpoint(r.selected.point,shape)){
+     r.gap="SHAPE_OR_TYPE_UNAVAILABLE";return;
+    }
+    uint64_t elements=1;
+    for(uint64_t dim:shape.ne){if(dim==0||dim>p->max_elements/elements){r.gap="SHAPE_OR_TYPE_UNAVAILABLE";return;}elements*=dim;}
+    if(elements*4!=shape.bytes){r.gap="SHAPE_OR_TYPE_UNAVAILABLE";return;}
+    std::vector<unsigned char> bytes(size_t(shape.bytes),0);
+    if(!read(bytes.data(),bytes.size())){r.gap="READ_UNAVAILABLE";return;}
+    if(p->kind==Kind::f32){for(size_t i=0;i<bytes.size();i+=4){float value;std::memcpy(&value,bytes.data()+i,4);if(!std::isfinite(value)){r.gap="NONFINITE";return;}}}
+    r.seen[arm]=true;r.token[arm]=token_;r.elements=uint32_t(bytes.size()/4);r.hash[arm]=fnv(bytes.data(),bytes.size());
+    r.shape[arm]=shape;
+    if(r.selected.point=="router_topk"&&r.elements==4){
+     std::memcpy(r.topk[arm].data(),bytes.data(),16);
+     std::array<bool,64> used{};
+     for(int32_t id:r.topk[arm]){if(id<0||id>=64||used[size_t(id)]){r.gap="ROUTER_ID_INVALID";fail("ROUTER_ID_INVALID");return;}used[size_t(id)]=true;}
+     r.topk_seen[arm]=true;
+    }
+    if((r.selected.point=="router_weights"||r.selected.point=="router_weights_norm"||
+        r.selected.point=="router_weights_scaled")&&r.elements==4){
+     std::memcpy(r.weights[arm].data(),bytes.data(),16);r.weights_seen[arm]=true;
+    }
+    if((r.selected.point=="router_logits"||r.selected.point=="router_logits_biased"||
+        r.selected.point=="router_probs"||r.selected.point=="router_probs_biased"||
+        r.selected.point=="router_probs_masked")&&r.elements==64){
+     std::array<float,64> scores{};std::memcpy(scores.data(),bytes.data(),bytes.size());
+     std::sort(scores.begin(),scores.end(),std::greater<float>{});
+     r.kth_margin[arm]=double(scores[3])-double(scores[4]);
+     for(size_t j=1;j<scores.size();++j)if(scores[j]==scores[j-1])++r.exact_score_ties[arm];
+     r.score_stats_seen[arm]=true;
+    }
+    if(arm==0){r.reference=std::move(bytes);r.gap="HYBRID_NOT_OBSERVED";}
+    else if(!r.seen[0]||r.token[0]!=token_||r.reference.size()!=bytes.size()||
+            r.shape[0].type!=shape.type||r.shape[0].op!=shape.op||
+            !std::equal(std::begin(r.shape[0].ne),std::end(r.shape[0].ne),std::begin(shape.ne))||
+            !std::equal(std::begin(r.shape[0].nb),std::end(r.shape[0].nb),std::begin(shape.nb))){r.gap="SEMANTIC_SHAPE_UNPAIRED";}
+    else if(r.selected.point=="moe_gate"||r.selected.point=="moe_up"||r.selected.point=="moe_activation"||
+            r.selected.point=="moe_down"||r.selected.point=="moe_weighted"){
+     const Row*route=nullptr;
+     for(size_t route_ix:by_position_[position_]){const auto&candidate=rows_[route_ix];
+      if(candidate.selected.layer==r.selected.layer&&candidate.selected.point=="router_topk"){route=&candidate;break;}}
+     if(!route||!route->seen[0]||!route->seen[1])r.gap="ROUTE_IDENTITY_UNOBSERVED";
+     else if(!route->gap.empty()||route->violations)r.gap="ROUTE_UNPAIRED";
+     else r.gap="ROUTE_MATCHED_COMPARISON_PENDING";
+    }
+    else{
+     for(size_t i=0;i<bytes.size();i+=4){
+      uint32_t a,b;std::memcpy(&a,r.reference.data()+i,4);std::memcpy(&b,bytes.data()+i,4);
+      if(a!=b&&r.first_difference==UINT32_MAX)r.first_difference=uint32_t(i/4);
+      if(p->kind==Kind::i32){if(a!=b){++r.violations;if(r.first_violation==UINT32_MAX)r.first_violation=uint32_t(i/4);}}
+      else{float af,bf;std::memcpy(&af,&a,4);std::memcpy(&bf,&b,4);
+       const auto delta=std::abs(double(af)-double(bf));r.max_abs=std::max(r.max_abs,delta);
+       if(delta>(double(abs_ppm_)+double(rel_ppm_)*std::abs(double(af)))/1000000.0){++r.violations;if(r.first_violation==UINT32_MAX)r.first_violation=uint32_t(i/4);}}
+     }
+     r.gap="";
+    }
+    if(r.gap=="ROUTE_MATCHED_COMPARISON_PENDING"){
+     for(size_t i=0;i<bytes.size();i+=4){
+      float af,bf;std::memcpy(&af,r.reference.data()+i,4);std::memcpy(&bf,bytes.data()+i,4);
+      uint32_t a,b;std::memcpy(&a,&af,4);std::memcpy(&b,&bf,4);
+      if(a!=b&&r.first_difference==UINT32_MAX)r.first_difference=uint32_t(i/4);
+      const auto delta=std::abs(double(af)-double(bf));r.max_abs=std::max(r.max_abs,delta);
+      if(delta>(double(abs_ppm_)+double(rel_ppm_)*std::abs(double(af)))/1000000.0){++r.violations;if(r.first_violation==UINT32_MAX)r.first_violation=uint32_t(i/4);}
+     }
+     r.gap="";
+    }
+    work_units_+=r.elements;if(work_units_>work_budget_)fail("GRAPH_WORK_BUDGET");
+    const auto elapsed=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();
+    if(elapsed<0||uint64_t(elapsed)>UINT64_MAX-time_ns_)fail("GRAPH_TIME_ACCOUNTING");
+    else{time_ns_+=uint64_t(elapsed);if(time_ns_>time_cap_ns_)fail("GRAPH_TIME_BUDGET");}
+    return;
+   }
+  }catch(...){fail("GRAPH_OBSERVER_FAILURE");}
+ }
