+void write_generation_trace(StreamSocket const& socket, const std::string& bytes,
+                            const std::string& sha256) {
+    if (bytes.size() != 517296 || sha256.size() != 64)
+        throw std::runtime_error("generation trace response bound");
+    const std::string header = "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\n"
+        "Content-Length: 517296\r\nX-Content-SHA256: " + sha256 +
+        "\r\nConnection: close\r\n\r\n";
+    DataWriter writer(socket.OutputStream());
+    writer.UnicodeEncoding(UnicodeEncoding::Utf8);
+    writer.WriteString(winrt::to_hstring(header));
+    writer.WriteBytes(winrt::array_view<const uint8_t>(
+        reinterpret_cast<const uint8_t*>(bytes.data()),
+        reinterpret_cast<const uint8_t*>(bytes.data() + bytes.size())));
+    writer.StoreAsync().get();
+    writer.FlushAsync().get();
+    writer.DetachStream();
 }
