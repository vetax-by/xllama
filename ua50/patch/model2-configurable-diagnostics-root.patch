+  for(size_t i=0;i<rows_.size();++i){const auto&r=rows_[i];if(i)s+=",";
+   s+="{\"phase\":2,\"position\":"+std::to_string(r.key.position)+",\"role\":"+std::to_string(r.key.role)+",\"expert\":"+std::to_string(r.key.expert)+",\"seen\":"+(r.seen?"true":"false");
