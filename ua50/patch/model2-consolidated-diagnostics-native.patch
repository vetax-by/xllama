+        if (slot<0 || slot>=ids->ne[0] || input_row<0 || input_row>=src1->ne[2] ||
+            src1->ne[0]!=expert->ne[0] || q8_bytes!=row_size ||
+            (uint64_t)(slot%src1->ne[1])>UINT64_MAX/src1->nb[1] ||
+            (uint64_t)input_row>UINT64_MAX/src1->nb[2] ||
+            (uint64_t)(slot%src1->ne[1])>UINT64_MAX/row_size ||
+            (uint64_t)input_row>UINT64_MAX/(uint64_t)src1->ne[1] ||
+            (uint64_t)slot>UINT64_MAX/dst->nb[1] ||
+            (uint64_t)input_row>UINT64_MAX/dst->nb[2]) {
+            ggml_ua50_diagnostic_unavailable(expert,"DIAGNOSTIC_ROW_EXTENT"); return;
+        }
+        const uint64_t i11=(uint64_t)(slot%src1->ne[1]);
+        const uint64_t foff=i11*src1->nb[1]+(uint64_t)input_row*src1->nb[2];
+        const uint64_t qrow=i11+(uint64_t)input_row*(uint64_t)src1->ne[1];
+        const uint64_t qoff=qrow*row_size;
+        const uint64_t doff=(uint64_t)slot*dst->nb[1]+(uint64_t)input_row*dst->nb[2];
+        if (foff>f32_bytes || (uint64_t)src1->ne[0]*sizeof(float)>f32_bytes-foff ||
+            qoff>q8_bytes*(uint64_t)src1->ne[1]*(uint64_t)src1->ne[2] ||
+            row_size>q8_bytes*(uint64_t)src1->ne[1]*(uint64_t)src1->ne[2]-qoff ||
+            doff>dst_bytes || (uint64_t)expert->ne[1]*sizeof(float)>dst_bytes-doff) {
+            ggml_ua50_diagnostic_unavailable(expert,"DIAGNOSTIC_BYTE_EXTENT"); return;
+        }
+        if (output) {
+            const float * values=(const float *)((const char *)dst->data+doff);
+            ggml_ua50_diagnostic_output(expert,(uint32_t)slot,(uint32_t)input_row,values,(uint64_t)expert->ne[1]);
+        } else {
+            const float * f32=(const float *)((const char *)src1->data+foff);
+            const void * q8=(const char *)packed+qoff;
+            ggml_ua50_diagnostic_input(expert,(uint32_t)slot,(uint32_t)input_row,f32,(uint64_t)expert->ne[0],q8,row_size);
+        }
+    }
