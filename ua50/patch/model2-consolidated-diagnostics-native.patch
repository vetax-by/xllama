+        src1->ne[1] <= 0 || src1->ne[1] > 4 || src1->ne[2] <= 0 || src1->ne[2] > 129 ||
+        ids->ne[0] <= 0 || ids->ne[0] > 4 ||
+        row_size != ggml_row_size(GGML_TYPE_Q8_K, expert->ne[0])) {
+        ggml_ua50_diagnostic_unavailable(expert,"DIAGNOSTIC_SHAPE"); return;
